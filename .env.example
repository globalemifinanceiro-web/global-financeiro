# Copie este arquivo para ".env" (nunca commitado) e preencha com valores reais quando a Etapa 2/3 começar.
# NENHUM valor real deve ser colocado neste arquivo de exemplo.

# ----------------------------------------------------------------------------
# App (Expo) — variáveis "EXPO_PUBLIC_*" ficam embutidas no bundle do cliente.
# Nunca coloque segredos aqui (chaves de serviço do Supabase, tokens de integração etc).
# ----------------------------------------------------------------------------

# "demo" (dados fictícios, só para testes) ou "real" (usa os dados de verdade do Supabase).
EXPO_PUBLIC_DATA_MODE=real

# Projeto Supabase usado pelo app (URL pública + chave anônima, seguras para o cliente).
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=coloque-a-chave-anonima-aqui

# ----------------------------------------------------------------------------
# Backend (Supabase Edge Functions) — configurados via `supabase secrets set`,
# NUNCA neste arquivo nem em qualquer lugar do repositório/app/frontend.
# Listados aqui apenas como referência do que será necessário.
# ----------------------------------------------------------------------------

# Credenciais das integrações externas, usadas pelas Edge Functions em supabase/functions.
# Definir com: supabase secrets set NOME=valor --project-ref ezussktdqmmvpqfzukwu

# Token de leitura da API do Projetos Global (usado por supabase/functions/sync-projetos-global).
# PROJETOS_GLOBAL_SYNC_TOKEN=

# Conteúdo integral do .json da conta de serviço do Google, com acesso de EDITOR à planilha
# "Controle Contas à Receber" (leitura em sync-contas-receber; escrita da DT PGTO em registrar-comprovante).
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Apps Script que salva os comprovantes na pasta "comprovantes" do Drive
# (código em apps-script/salvar-comprovante.gs; usado por supabase/functions/registrar-comprovante).
# APPS_SCRIPT_URL=
# APPS_SCRIPT_TOKEN=
