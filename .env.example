# Copie este arquivo para ".env" (nunca commitado) e preencha com valores reais quando a Etapa 2/3 começar.
# NENHUM valor real deve ser colocado neste arquivo de exemplo.

# ----------------------------------------------------------------------------
# App (Expo) — variáveis "EXPO_PUBLIC_*" ficam embutidas no bundle do cliente.
# Nunca coloque segredos aqui (App Key/Secret da Omie, service role do Supabase etc).
# ----------------------------------------------------------------------------

# "demo" (dados fictícios) ou "real" (chama o backend). Comece sempre em "demo".
EXPO_PUBLIC_DATA_MODE=demo

# Projeto Supabase usado pelo app (URL pública + chave anônima, seguras para o cliente).
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=coloque-a-chave-anonima-aqui

# ----------------------------------------------------------------------------
# Backend (Supabase Edge Functions) — configurados via `supabase secrets set`,
# NUNCA neste arquivo nem em qualquer lugar do repositório/app/frontend.
# Listados aqui apenas como referência do que será necessário.
# ----------------------------------------------------------------------------

# OMIE_APP_KEY=
# OMIE_APP_SECRET=
# GOOGLE_SERVICE_ACCOUNT_JSON=
